# Local dev stack only (docker-compose.dev.yml) — never used in prod.
# Copy to .env.dev and adjust if you like; the weak default password is fine
# since this Postgres is only reachable from localhost:5433.
#
# Usage:
#   cp .env.dev.example .env.dev
#   docker compose -f docker-compose.dev.yml --env-file .env.dev up -d --build

# ── PostgreSQL ──────────────────────────────
POSTGRES_DB=vestis_dev
POSTGRES_USER=vestis_dev
POSTGRES_PASSWORD=dev_only_password

# ── Telegram (optional — leave empty to disable notifications locally) ──────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
